{
  "name": "@bistro/backend",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:catalog:db": "node test/catalog-db.test.cjs",
    "test:catalog:availability:db": "node test/catalog-availability-db.test.cjs",
    "test:catalog:menu:db": "node test/catalog-menu-db.test.cjs",
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "test:integration": "node test/integration.cjs",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed:qa": "node scripts/seed-qa.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "prisma": "^5.22.0",
    "typescript": "^5.7.0"
  }
}
