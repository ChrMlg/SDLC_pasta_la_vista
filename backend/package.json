{
  "name": "@bistro/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prestart": "npm run prisma:generate && npm run build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:catalog:db": "node test/catalog-db.test.cjs",
    "test:catalog:availability:db": "node test/catalog-availability-db.test.cjs",
    "test:catalog:menu:db": "node test/catalog-menu-db.test.cjs",
    "test": "jest --runInBand && npm run test:legacy && node --test test/production-config.test.cjs",
    "test:integration": "node test/integration.cjs",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "test:h10": "node --test test/h10-rules.test.cjs test/h10-integration.test.cjs",
    "test:h11": "node --test test/h11-rules.test.cjs test/h11-integration.test.cjs",
    "test:h12": "node --test test/h12-integration.test.cjs",
    "test:h13": "node --test test/h13-integration.test.cjs",
    "test:h14": "node --test test/h14-integration.test.cjs",
    "test:h15": "node --test test/h15-integration.test.cjs",
    "test:h19": "node --test test/h19-integration.test.cjs",
    "test:h20": "node --test test/h20-integration.test.cjs",
    "test:h21": "node --test test/h21-integration.test.cjs",
    "test:h22": "node --test test/h22-integration.test.cjs",
    "test:h6": "node --test test/h6-integration.test.cjs",
    "test:h7": "node --test test/h7-integration.test.cjs",
    "db:project": "node scripts/project-db.cjs",
    "test:h8": "node --test test/h8-integration.test.cjs",
    "test:h9": "node --test test/h9-integration.test.cjs",
    "test:h23": "node --test test/h23-rules.test.cjs test/h23-integration.test.cjs",
    "test:h24": "node --test test/h24-integration.test.cjs",
    "test:h25": "node --test test/h25-integration.test.cjs",
    "test:h31": "node --test test/h31-integration.test.cjs",
    "test:h32": "node --test test/h32-integration.test.cjs",
    "test:h33": "node --test test/h33-integration.test.cjs",
    "test:h34": "node --test test/h34-integration.test.cjs",
    "test:h35": "node --test test/h35-integration.test.cjs",
    "test:initial-accounts": "node --test test/initial-accounts.test.cjs",
    "test:legacy": "node --experimental-transform-types --test test/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "newman": "^6.2.3",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  }
}
