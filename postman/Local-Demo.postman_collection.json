    {
      "name": "Pagar con tarjeta simulada",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/bills/{{billId}}/payments",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "idempotency-key",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"cardHolder\": \"Cliente Demostracion\", \"cardNumber\": \"4242424242424242\", \"expMonth\": 12, \"expYear\": {{cardYear}}, \"cvv\": \"123\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test('Pago aprobado',()=>pm.expect(pm.response.json().status).to.eql('PAID'));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('cardYear',new Date().getUTCFullYear()+2);"
            ]
          }
        }
      ]
    },
