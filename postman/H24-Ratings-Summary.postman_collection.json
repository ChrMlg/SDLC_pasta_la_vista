{
  "info": {
    "name": "H24 — Promedio de calificaciones por sucursal (#55)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Seleccionar environment local con cuentas existentes. branchId debe ser la sucursal del gerente y otherBranchId otra existente. Ejecutar en orden para cambiar sesiones. Las consultas no modifican reseñas. Fechas YYYY-MM-DD, ambas o ninguna; día final inclusive en America/El_Salvador. Sin reseñas: averageRating=null y reviewCount=0. La preparación automática de cuentas en instalaciones nuevas sigue pendiente."
  },
  "item": [
    {
      "name": "01 Login gerente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{managerEmail}}\", \"password\": \"{{managerPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200); "
            ]
          }
        }
      ]
    },
    {
      "name": "02 Resumen sin fechas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/management/branches/{{branchId}}/ratings/summary"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200); const b=pm.response.json(); pm.expect(b.reviewCount).to.be.a('number'); pm.expect(b.averageRating === null || (b.averageRating >= 1 && b.averageRating <= 5)).to.eql(true);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Resumen por días locales inclusivos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/management/branches/{{branchId}}/ratings/summary?dateFrom={{dateFrom}}&dateTo={{dateTo}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200); "
            ]
          }
        }
      ]
    },
