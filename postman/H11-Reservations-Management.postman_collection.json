        "url": "{{baseUrl}}/reservations/{{h11ReservationId}}/cancel",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Error uniforme', () => pm.expect(pm.response.json()).to.have.all.keys('code', 'message', 'field'));",
              "pm.test('Ya cancelada', () => pm.expect(pm.response.json().code).to.eql('RESERVATION_ALREADY_CANCELLED'));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "H11 - Ocupación después de cancelar",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{managerCookie}}"
          }
        ],
        "url": "{{baseUrl}}/management/branches/{{branchId}}/occupancy?date={{reservationDate}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Sucursal y zona horaria', () => { const r = pm.response.json(); pm.expect(r.branchId).to.eql(pm.environment.get('branchId')); pm.expect(r.timeZone).to.eql('America/El_Salvador'); });",
              "pm.test('Ocupación por mesas distintas', () => { const r = pm.response.json(); pm.expect(r.totalTables).to.be.above(0); r.slots.forEach(s => { pm.expect(s.occupancyPercentage).to.eql(Math.round(s.reservedTables / r.totalTables * 10000) / 100); pm.expect(s.availableTables).to.eql(r.totalTables - s.reservedTables); }); });",
              "pm.test('Reserva cancelada en el listado', () => pm.expect(pm.response.json().reservations.some(r => r.id === pm.environment.get('h11ReservationId') && r.status === 'CANCELLED')).to.eql(true));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "H11 - Notificación al cliente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{customerCookie}}"
          }
        ],
        "url": "{{baseUrl}}/notifications?sourceModule=RESERVATIONS"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Aviso de cancelación', () => pm.expect(pm.response.json().data.some(n => n.relatedEntityId === pm.environment.get('h11ReservationId') && n.title === 'Reservación cancelada')).to.eql(true));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    }
  ]
}
