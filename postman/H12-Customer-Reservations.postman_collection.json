{
  "info": {
    "name": "H12 - Reservaciones propias (#43)",
    "description": "Ejecutar solo en PostgreSQL local QA con el entorno privado generado por db:seed:h10:qa. Usa una fecha futura y crea/cancela una reserva de H10. La suite test:h12 verifica adicionalmente aislamiento entre clientes, reserva ajena 403, plazos, concurrencia con gerencia y fallos de notificación.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "H12 - Listado sin sesión",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/me/reservations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Error uniforme', () => pm.expect(pm.response.json()).to.have.all.keys('code', 'message', 'field'));"
