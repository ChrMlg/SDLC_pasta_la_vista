              "pm.test('Listado cronológico', () => { const list = pm.response.json(); pm.expect(list).to.be.an('array'); const keys = list.map(r => r.date + ' ' + r.startTime + ' ' + r.id); pm.expect(keys).to.eql([...keys].sort()); });",
