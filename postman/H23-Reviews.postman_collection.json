              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Contrato de reseña', () => pm.expect(pm.response.json()).to.have.all.keys('id','orderId','clientId','branchId','rating','comment','createdAt'));",
                  "if (pm.response.code === 201) pm.environment.set('reviewId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders/{{orderId}}/reviews",
            "body": {
