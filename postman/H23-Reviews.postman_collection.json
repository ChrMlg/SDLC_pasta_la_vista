            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('Contrato de error', () => pm.expect(pm.response.json()).to.have.all.keys('code', 'message', 'field'));",
                  "pm.test('Mensaje de duplicado', () => pm.expect(pm.response.json().message).to.eql('Este pedido ya tiene una reseña'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Elegibilidad después de reseñar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}/review-eligibility"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('No admite otra reseña', () => pm.expect(pm.response.json().canReview).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
