        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Aviso de la reservación creada', () => pm.expect(pm.response.json().data.some(n => n.eventKey === 'reservation.confirmed:' + pm.environment.get('reservationId'))).to.eql(true));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
