    {
      "name": "H10 - Registrar reservación",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{customerCookie}}"
          }
        ],
        "url": "{{baseUrl}}/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\"branchId\": \"{{branchId}}\", \"date\": \"{{reservationDate}}\", \"time\": \"12:00\", \"partySize\": 2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Reservación confirmada por 90 minutos', () => { const r = pm.response.json(); pm.expect(r.status).to.eql('CONFIRMED'); pm.expect(r.startTime).to.eql('12:00'); pm.expect(r.endTime).to.eql('13:30'); pm.expect(r.branchId).to.eql(pm.environment.get('branchId')); });",
              "if (pm.response.code === 201) pm.environment.set('reservationId', pm.response.json().id);"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "H10 - Aviso de confirmación",
      "request": {
