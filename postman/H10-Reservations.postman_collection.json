{
  "info": {
    "name": "H10 - Table reservations (#41)",
    "description": "Registro de reservaciones y consulta de horarios. Ejecutar en una base local de pruebas usando el entorno preparado con db:seed:h10:qa. Cada ejecución registra una reserva. La suite test:h10 comprueba además concurrencia y persistencia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "H10 - Sin sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\"branchId\": \"{{branchId}}\", \"date\": \"{{reservationDate}}\", \"time\": \"12:00\", \"partySize\": 2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Formato de error', () => pm.expect(pm.response.json()).to.have.all.keys('code', 'message', 'field'));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
