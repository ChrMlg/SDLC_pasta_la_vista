    {
      "name": "H10 - Horarios disponibles",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{customerCookie}}"
          }
        ],
        "url": "{{baseUrl}}/branches/{{branchId}}/reservation-availability?date={{reservationDate}}&partySize=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Zona horaria', () => pm.expect(pm.response.json().timeZone).to.eql('America/El_Salvador'));",
              "pm.test('Bloques horarios', () => pm.expect(pm.response.json().slots.map(s => s.time)).to.eql(['12:00','13:00','14:00','15:00','16:00','17:00','18:00','19:00','20:00']));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
