          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Listado de insumos', () => {",
              "  const rows = pm.response.json(); pm.expect(rows).to.be.an('array');",
              "  pm.expect(rows.length).to.be.at.least(5);",
              "  rows.forEach(row => {",
              "    pm.expect(row).to.have.all.keys('id','branchId','name','unit','minStock','currentStock');",
              "    pm.expect(row.branchId).to.equal(pm.environment.get('branchId'));",
              "    pm.expect(row.id).to.match(/^[0-9a-f-]{36}$/i);",
              "    pm.expect(row.name.trim()).not.to.equal(''); pm.expect(row.unit.trim()).not.to.equal('');",
              "    for (const field of ['minStock','currentStock']) { pm.expect(Number.isInteger(row[field])).to.equal(true); pm.expect(row[field]).to.be.at.least(0); }",
              "  });",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "H13 - Cerrar sesión de gerente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{managerCookie}}"
          }
        ],
        "url": "{{baseUrl}}/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "H13 - Sesión revocada",
