{
  "info": {
    "name": "H9 — Recogida y entrega (#40)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección manual por pasos para Docker local. Seleccionar environment, completar cuenta WAITER de branchId, consultar READY y copiar orderId de un pedido propio de prueba. Requiere completar cocina H7/H8 previamente. Ejecutar pasos 04–08 una vez sobre ese pedido: modifican estados y generan avisos persistentes. Sin credenciales privadas en este archivo. La preparación automática de cuentas y la comprobación de instalación nueva siguen pendientes."
  },
  "item": [
    {
      "name": "01 Salud",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200); "
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login mesero",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{waiterEmail}}\", \"password\": \"{{waiterPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200); "
            ]
          }
        }
      ]
    },
    {
      "name": "03 Consultar pedidos listos y copiar orderId",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/branches/{{branchId}}/orders?status=READY"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200); "
            ]
          }
        }
      ]
    },
    {
      "name": "04 Entrega directa rechazada",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/branches/{{branchId}}/orders/{{orderId}}/deliver",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('INVALID_ORDER_TRANSITION');"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Recoger pedido",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/branches/{{branchId}}/orders/{{orderId}}/pickup",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('OUT_FOR_DELIVERY'); pm.expect(pm.response.json().pickedUpAt).to.be.a('string');"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Repetir recogida rechazada",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/branches/{{branchId}}/orders/{{orderId}}/pickup",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(409); "
            ]
          }
        }
      ]
    },
    {
      "name": "07 Confirmar entrega",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/branches/{{branchId}}/orders/{{orderId}}/deliver",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('DELIVERED'); pm.expect(pm.response.json().deliveredAt).to.be.a('string');"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Repetir entrega rechazada",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/branches/{{branchId}}/orders/{{orderId}}/deliver",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(409); "
            ]
          }
        }
      ]
    },
    {
      "name": "09 Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/logout",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200); "
            ]
          }
        }
      ]
    }
  ]
}
