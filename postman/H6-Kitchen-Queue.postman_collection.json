    {
      "name": "01 Cola H6",
      "item": [
        {
          "name": "Pendientes y en preparación",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/branches/{{branchId}}/kitchen/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Listado de comandas', () => { const b=pm.response.json(); pm.expect(b.items).to.be.an('array'); b.items.forEach(x=>{ pm.expect(x).to.include.all.keys('orderId','orderNumber','tableLabel','type','status','enteredAt','items'); x.items.forEach(i=>pm.expect(i).to.have.all.keys('id','dishName','quantity','note','isReady')); }); });",
                  "pm.test('Orden de llegada', () => { const a=pm.response.json().items; for(let i=1;i<a.length;i++) pm.expect(Date.parse(a[i].enteredAt)).to.be.at.least(Date.parse(a[i-1].enteredAt)); });",
                  "pm.test('Estados por defecto', () => pm.response.json().items.forEach(x=>pm.expect(['PENDING','IN_PREPARATION']).to.include(x.status)));"
                ]
              }
            }
          ]
        },
