{
  "info": {
    "name": "H15 - Alertas de reabastecimiento (#46)",
    "description": "Consulta y permisos de alertas usando PostgreSQL local con Docker. Importar el entorno privado postman/.env.project.local o completar H15-Local sin versionar secretos. Ejecutar en orden. Esta colección no modifica existencias; las pruebas test:h15 verifican generación IN/OUT, límite, resolución, nuevo período, concurrencia y rollback con datos temporales aislados dentro de la misma base local. El listado contiene ACTIVE y RESOLVED: currentStock/minStock de la alerta son históricos, item.currentStock/item.minStock son valores actuales. No existe filtro status ni cron.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "H15 - Sin sesión",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/management/branches/{{branchId}}/inventory/alerts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Error uniforme', () => pm.expect(pm.response.json()).to.have.all.keys('code','message','field'));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "H15 - Inicio de sesión customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{customerEmail}}\", \"password\": \"{{customerPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset('customerCookie');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const cookie=pm.response.headers.get('set-cookie'); pm.test('Cookie de sesión', () => pm.expect(cookie).to.include('HttpOnly')); pm.environment.set('customerCookie',cookie.split(';')[0]); }"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
