    {
      "name": "H15 - Listado gerente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{managerCookie}}"
          }
        ],
        "url": "{{baseUrl}}/management/branches/{{branchId}}/inventory/alerts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Lista por sucursal con datos del insumo', () => { const rows=pm.response.json(); pm.expect(rows).to.be.an('array'); rows.forEach(row => { pm.expect(row.branchId).to.eql(pm.environment.get('branchId')); pm.expect(row.item.name).to.be.a('string'); pm.expect(row.item.currentStock).to.be.at.least(0); pm.expect(row.branch.name).to.be.a('string'); pm.expect(row.status).to.be.oneOf(['ACTIVE','RESOLVED']); }); });",
              "pm.test('Una sola ACTIVE por insumo', () => { const active=pm.response.json().filter(row=>row.status==='ACTIVE'); pm.expect(new Set(active.map(row=>row.itemId)).size).to.eql(active.length); });",
              "pm.test('Auditoría de resolución consistente', () => pm.response.json().forEach(row => { if(row.status==='ACTIVE') {pm.expect(row.resolvedAt).to.eql(null);pm.expect(row.resolvedByUserId).to.eql(null);} else {pm.expect(row.resolvedAt).to.be.a('string');pm.expect(row.resolvedByUserId).to.be.a('string');} }));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
