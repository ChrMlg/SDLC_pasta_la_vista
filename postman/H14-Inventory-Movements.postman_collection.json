{
  "info": {
    "name": "H14 - Movimientos de inventario (#45)",
    "description": "Usa los datos persistentes del proyecto y el entorno privado local con Docker. Ejecutar en orden: registra IN 1 g y OUT 1 g de arroz, conserva ambas auditorías y comprueba el saldo original. Si se interrumpe después de IN, revisar el historial antes de repetir. Concurrencia, rollback y resolución de alertas se verifican en test:h14.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "H14 - Sin sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/management/inventory/movements",
        "body": {
          "mode": "raw",
          "raw": "{\"branchId\": \"{{branchId}}\", \"itemId\": \"{{itemId}}\", \"quantity\": 1, \"type\": \"IN\", \"reason\": \"Verificación H14: entrada de 1 g de arroz\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Error uniforme', () => pm.expect(pm.response.json()).to.have.all.keys('code','message','field'));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
