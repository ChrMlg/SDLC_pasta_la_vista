                  "pm.test('Toma auditada', () => { const b=pm.response.json(); pm.expect(b).to.have.all.keys('orderId','ticketStatus','orderStatus','takenById','takenAt'); pm.expect(b.ticketStatus).to.eql('IN_PREPARATION'); pm.expect(b.orderStatus).to.eql('IN_PREPARATION'); pm.expect(b.takenById).to.be.a('string'); pm.expect(Number.isFinite(Date.parse(b.takenAt))).to.eql(true); });"
                ]
