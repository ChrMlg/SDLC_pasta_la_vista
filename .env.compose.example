# Referencia sin secretos. npm start prepara .env.compose.local en una instalación nueva.
# Si existe un volumen, conservar su archivo privado y sus credenciales originales.
API_PORT=3000
DB_PORT=55440
APP_PORT=8080
POSTGRES_DB=bistro
POSTGRES_USER=bistro
# Use a URL-safe value because Compose inserts this into DATABASE_URL.
POSTGRES_PASSWORD=
COOKIE_SECURE=false
